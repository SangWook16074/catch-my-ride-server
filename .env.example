# 복사해서 .env로 만들고 실값을 채울 것 — .env는 절대 커밋하지 않는다 (gitignore 처리됨)
# 원본 보관: 비밀번호 관리자(1Password 등)에 전체 키 세트를 백업해 둘 것
# 로컬 실행: set -a; source .env; set +a; ./gradlew bootRun
# 배포 VM:  /opt/catchmyride/.env (chmod 600) → docker compose가 env_file로 주입

# 공공데이터포털(data.go.kr) "Encoding" 인증키 — TOPIS(서울버스)·GBIS(경기버스) 공용
DATA_GO_KR_KEY=

# 서울열린데이터광장(data.seoul.go.kr) 인증키 — 지하철 실시간 도착
SEOUL_OPEN_DATA_KEY=

# --- 아래는 Phase 1 배포 시점부터 필요 ---

# PostgreSQL (docker compose의 postgres 컨테이너와 앱이 공유)
POSTGRES_PASSWORD=

# 푸시 발송 인증은 별도 API 키가 아니라 아래 TOSS_MTLS_KEYSTORE(mTLS)로 한다 — 2026-09-08 스펙 확정
# (구 APPS_IN_TOSS_API_KEY는 폐기)

# 푸시 템플릿 코드 2종 = 콘솔 "발송 코드" (스마트 발송 > 기능성 탭 — docs/push-templates.md)
# 비어 있으면 dry-run: 스케줄러는 돌지만 실발송 없이 push_log에만 기록한다
PUSH_TEMPLATE_PRE=catch-my-ride-pre-start
PUSH_TEMPLATE_REMIND=catch-my-ride-remind

# 네이버클라우드 Maps — 지도 미리보기(§6)·주소 검색(§7) 프록시용 (콘솔 > Maps > Static Map·Geocoding 이용 신청)
# 비어 있으면 두 엔드포인트는 503 — 클라이언트가 OSM 폴백/안내 문구로 강등
NCP_MAP_KEY_ID=
NCP_MAP_KEY=

# 앱인토스 파트너 mTLS 클라이언트 인증서 — 토스 로그인(API.md §8) + 푸시 발송(§4) 공용
# 비어 있으면 푸시는 dry-run으로 동작한다
# PEM(cert+key) → PKCS12 변환: openssl pkcs12 -export -in cert.pem -inkey key.pem -out toss-mtls.p12
# 비어 있으면 /api/v1/auth/* 는 503, 요청 인증은 AUTH_DEV_USER_KEY 폴백 (로컬 E2E용)
TOSS_MTLS_KEYSTORE=
TOSS_MTLS_KEYSTORE_PASSWORD=

# 라이브 전환 시 빈 값으로 설정 — 헤더 없는 요청을 401로 강제 (기본 dev-user는 로컬 전용)
# AUTH_DEV_USER_KEY=
