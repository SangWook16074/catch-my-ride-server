# 복사해서 .env로 만들고 실값을 채울 것 — .env는 절대 커밋하지 않는다 (gitignore 처리됨)
# 원본 보관: 비밀번호 관리자(1Password 등)에 전체 키 세트를 백업해 둘 것
# 로컬 실행: set -a; source .env; set +a; ./gradlew bootRun
# 배포 VM:  /opt/catchmyride/.env (chmod 600) → docker compose가 env_file로 주입

# 공공데이터포털(data.go.kr) "Encoding" 인증키 — TOPIS(서울버스)·GBIS(경기버스) 공용
DATA_GO_KR_KEY=

# 서울열린데이터광장(data.seoul.go.kr) 인증키 — 지하철 실시간 도착
SEOUL_OPEN_DATA_KEY=

# --- 아래는 Phase 1 배포 시점부터 필요 ---

# PostgreSQL (docker compose의 postgres 컨테이너와 앱이 공유)
POSTGRES_PASSWORD=

# 앱인토스 파트너 키 — 푸시 발송 권한. 가장 민감한 키이므로 각별히 주의
# (콘솔 등록 P0-6 후 발급되는 실제 항목명에 맞춰 갱신할 것)
APPS_IN_TOSS_API_KEY=

# 승인된 푸시 템플릿 코드 2종 (P0-7 검수 통과 후 — docs/push-templates.md)
# 비어 있으면 dry-run: 스케줄러는 돌지만 실발송 없이 push_log에만 기록한다
PUSH_TEMPLATE_PRE=
PUSH_TEMPLATE_REMIND=

# 네이버클라우드 Maps — 지도 미리보기(§6)·주소 검색(§7) 프록시용 (콘솔 > Maps > Static Map·Geocoding 이용 신청)
# 비어 있으면 두 엔드포인트는 503 — 클라이언트가 OSM 폴백/안내 문구로 강등
NCP_MAP_KEY_ID=
NCP_MAP_KEY=
